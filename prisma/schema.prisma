// CampaignCue — B2B Instagram Comment → DM SaaS schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  output          = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  ownedWorkspaces   Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers  WorkspaceMember[]
  sentInvitations   WorkspaceInvitation[] @relation("WorkspaceInvitationsSent")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan                 Plan                @default(FREE)
  subscriptionStatus   SubscriptionStatus  @default(NONE)
  stripeCustomerId     String?             @unique
  stripeSubscriptionId String?             @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  usagePeriodStart     DateTime            @default(now())
  dmsSentThisPeriod    Int                 @default(0)

  members           WorkspaceMember[]
  invitations       WorkspaceInvitation[]
  instagramAccounts InstagramAccount[]
  automations       Automation[]
  dmLogs            DmLog[]
  deliveryJobs      DeliveryJob[]
  contacts          Contact[]
  contactEvents     ContactEvent[]
  trackedLinks      TrackedLink[]
  linkClicks        LinkClick[]
  webhookEvents     WebhookEvent[]
  billingEvents     BillingEvent[]
  operationalEvents OperationalEvent[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvitation {
  id              String                    @id @default(cuid())
  workspaceId     String
  email           String
  role            WorkspaceRole             @default(MEMBER)
  token           String                    @unique
  status          WorkspaceInvitationStatus @default(PENDING)
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("WorkspaceInvitationsSent", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([email])
  @@index([workspaceId])
  @@index([status])
}

model InstagramAccount {
  id                String   @id @default(cuid())
  workspaceId       String
  instagramId       String   @unique
  username          String
  name              String?
  accessToken       String
  tokenExpiresAt    DateTime?
  webhookSubscribed Boolean  @default(false)
  connectedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automations  Automation[]
  dmLogs       DmLog[]
  deliveryJobs DeliveryJob[]
  contacts     Contact[]
  linkClicks   LinkClick[]

  @@index([workspaceId])
}

model Automation {
  id                 String      @id @default(cuid())
  workspaceId        String
  instagramAccountId String

  name           String
  goal           String?
  triggerType    TriggerType @default(COMMENT)
  triggerScope   String      @default("SPECIFIC_POST")
  postId         String?
  postUrl        String?
  consumedPostId String?
  consumedAt     DateTime?
  keywords       String[]
  dmMessage      String
  publicReplyMessage String?
  isActive       Boolean     @default(true)
  wholeWordMatch Boolean     @default(true)
  reportShareSlug    String? @unique
  reportShareEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount            @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  keywordsList     AutomationKeyword[]
  variations       AutomationMessageVariation[]
  dmLogs           DmLog[]
  deliveryJobs     DeliveryJob[]
  trackedLinks     TrackedLink[]
  linkClicks       LinkClick[]

  @@index([workspaceId])
  @@index([instagramAccountId, postId, isActive])
  @@index([instagramAccountId, triggerScope, isActive])
}

model AutomationKeyword {
  id                String   @id @default(cuid())
  automationId      String
  keyword           String
  normalizedKeyword String
  createdAt         DateTime @default(now())

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([automationId, normalizedKeyword])
  @@index([automationId])
  @@index([normalizedKeyword])
}

model AutomationMessageVariation {
  id           String   @id @default(cuid())
  automationId String
  message      String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  automation   Automation    @relation(fields: [automationId], references: [id], onDelete: Cascade)
  deliveryJobs DeliveryJob[]

  @@index([automationId])
}

model Contact {
  id                 String   @id @default(cuid())
  workspaceId        String
  instagramAccountId String
  instagramUserId    String
  username           String?
  displayName        String?
  profilePicUrl      String?
  firstSeenAt        DateTime @default(now())
  lastSeenAt         DateTime @default(now())
  lastInteractionAt  DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  events           ContactEvent[]
  deliveryJobs     DeliveryJob[]
  linkClicks       LinkClick[]

  @@unique([workspaceId, instagramAccountId, instagramUserId])
  @@index([workspaceId, lastInteractionAt])
  @@index([instagramAccountId, lastInteractionAt])
  @@index([workspaceId, username])
}

enum ContactEventType {
  COMMENT
  DM_SENT
  PUBLIC_REPLY
  LINK_CLICK
  AUTOMATION_TRIGGERED
}

model ContactEvent {
  id                 String           @id @default(cuid())
  workspaceId        String
  contactId          String
  instagramAccountId String
  type               ContactEventType
  referenceId        String?
  metadata           Json?
  createdAt          DateTime         @default(now())

  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt])
  @@index([workspaceId, createdAt])
}

model DeliveryJob {
  id                  String      @id @default(cuid())
  workspaceId         String
  instagramAccountId  String
  automationId        String
  contactId           String?
  triggerType         TriggerType @default(COMMENT)
  triggerId           String
  recipientId         String
  recipientUsername   String?
  status              DmStatus    @default(PENDING)
  matchedKeyword      String?
  messagePayload      String
  selectedVariationId String?
  attemptCount        Int         @default(0)
  scheduledAt         DateTime    @default(now())
  processingStartedAt DateTime?
  sentAt              DateTime?
  metaMessageId       String?
  lastError           String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  workspace         Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount  InstagramAccount            @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  automation        Automation                  @relation(fields: [automationId], references: [id], onDelete: Cascade)
  contact           Contact?                    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  selectedVariation AutomationMessageVariation? @relation(fields: [selectedVariationId], references: [id], onDelete: SetNull)
  attempts          DeliveryAttempt[]
  linkClicks        LinkClick[]

  @@unique([automationId, triggerId])
  @@index([workspaceId, createdAt])
  @@index([instagramAccountId, status, createdAt])
  @@index([automationId, createdAt])
  @@index([status, scheduledAt])
  @@index([recipientId, createdAt])
}

model DeliveryAttempt {
  id            String    @id @default(cuid())
  deliveryJobId String
  attemptNumber Int
  status        DmStatus
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  metaMessageId String?
  errorCode     String?
  errorType     String?
  errorMessage  String?
  createdAt     DateTime  @default(now())

  deliveryJob DeliveryJob @relation(fields: [deliveryJobId], references: [id], onDelete: Cascade)

  @@unique([deliveryJobId, attemptNumber])
  @@index([deliveryJobId])
}

model DmLog {
  id                 String     @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String

  commenterId   String
  commenterName String?
  commentText   String
  commentId     String
  matchedKeyword String?
  status        DmStatus @default(PENDING)
  attempts      Int      @default(0)
  dmSentAt      DateTime?
  errorMessage  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([automationId, commentId])
  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([status])
}

model TrackedLink {
  id             String   @id @default(cuid())
  workspaceId    String
  automationId   String
  slug           String   @unique
  label          String?
  destinationUrl String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation Automation  @relation(fields: [automationId], references: [id], onDelete: Cascade)
  clicks     LinkClick[]

  @@index([workspaceId])
  @@index([automationId])
}

model LinkClick {
  id                 String   @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String
  trackedLinkId      String
  deliveryJobId      String?
  contactId          String?
  ipHash             String?
  userAgent          String?
  referrer           String?
  createdAt          DateTime @default(now())

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  trackedLink      TrackedLink      @relation(fields: [trackedLinkId], references: [id], onDelete: Cascade)
  deliveryJob      DeliveryJob?     @relation(fields: [deliveryJobId], references: [id], onDelete: SetNull)
  contact          Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([trackedLinkId])
  @@index([deliveryJobId])
  @@index([contactId])
  @@index([createdAt])
  @@index([workspaceId, createdAt])
}

model WebhookEvent {
  id              String        @id @default(cuid())
  workspaceId     String?
  externalEventId String?       @unique
  eventType       String?
  object          String?
  payload         Json
  status          WebhookStatus @default(PENDING)
  errorMessage    String?
  createdAt       DateTime      @default(now())
  processedAt     DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([status])
  @@index([createdAt])
}

model BillingEvent {
  id          String   @id @default(cuid())
  workspaceId String?
  stripeEventId String @unique
  type        String
  payload     Json
  processedAt DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
}

model OperationalEvent {
  id          String                @id @default(cuid())
  workspaceId String?
  source      OperationalEventSource
  level       OperationalEventLevel @default(INFO)
  message     String
  payload     Json?
  createdAt   DateTime              @default(now())
  resolvedAt  DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([source])
  @@index([level])
  @@index([createdAt])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum Plan {
  FREE
  PRO
  AGENCY
}

enum SubscriptionStatus {
  NONE
  TRIALING
  ACTIVE
  PAST_DUE
  UNPAID
  CANCELED
}

enum DmStatus {
  PENDING
  // Meta API call is in-flight. If a worker sees this on retry it means a prior
  // attempt may have already sent the DM. Transition → UNKNOWN, do not re-send.
  SENDING
  SENT
  FAILED
  // Ambiguous outcome: Meta may or may not have delivered the DM (e.g. network
  // timeout after request was dispatched). Do NOT retry automatically.
  UNKNOWN
  SKIPPED_DEDUP
  SKIPPED_RATE_LIMIT
  SKIPPED_PLAN_LIMIT
  SKIPPED_NO_MATCH
}

enum WebhookStatus {
  // Webhook received and signature verified; payload persisted.
  PENDING
  // All comment jobs have been bulk-enqueued into BullMQ.
  QUEUED
  // Kept for backward compatibility with rows created before this migration.
  PROCESSED
  FAILED
}

enum OperationalEventSource {
  WORKER
  TOKEN_REFRESH
  HEALTH
  SYSTEM
}

enum OperationalEventLevel {
  INFO
  WARNING
  ERROR
}

enum TriggerType {
  // Phase 1: comment on a specific post/reel triggers a DM.
  COMMENT
  // Future: DM_KEYWORD, STORY_REPLY, etc. — add values here without rewriting the core.
}
